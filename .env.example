# Sanity project. Public: built into the Studio and the site's browser code.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Public origin for canonical URLs and the sitemap. Defaults to the workers.dev URL.
# VITE_SITE_URL=https://marquee-insights.tousifahmed.workers.dev

# Secrets. Server only; never prefix these with SANITY_STUDIO_.
# Viewer token from sanity.io/manage > API > Tokens, used to read drafts in preview.
SANITY_READ_TOKEN=
# Random string editors put in /api/preview/enable?secret=...  (openssl rand -hex 32)
SANITY_PREVIEW_SECRET=
# Secret set on the Sanity publish webhook; verifies calls to /api/revalidate.  (openssl rand -hex 32)
SANITY_WEBHOOK_SECRET=

# Neon Postgres connection string (pooled). Server only; a Worker secret in production.
DATABASE_URL=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marquee-insights",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // No placement setting: the Worker runs near each visitor, so KV cache hits
  // stay fast. Pinning it to aws:us-east-1 (next to Neon) made cached pages
  // 10-20x slower for distant visitors and barely helped the explorer, whose
  // server functions already batch their queries into one round trip.
  // Rendered content pages are cached in KV (src/lib/page-cache-store.ts) so a
  // publish can invalidate them. The Workers cache runs before the Worker and
  // cannot be purged on workers.dev, so it stays off or it would serve pages
  // for up to s-maxage after a publish.
  "cache": {
    "enabled": false
  },
  // Part of every page cache key, so a deploy never serves HTML that points at
  // the previous build's assets.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "kv_namespaces": [
    {
      "binding": "PAGE_CACHE",
      "id": "a1116efc0bbd4da4943a61ed988721e5"
    }
  ]
}

{
  "name": "marquee-insights",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "studio": "pnpm --filter studio dev",
    "studio:build": "pnpm --filter studio build",
    "studio:deploy": "pnpm --filter studio deploy",
    "seed": "tsx scripts/seed.ts",
    "seed:content": "pnpm --filter studio exec sanity exec ../scripts/seed-content/index.ts --with-user-token",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsr generate && pnpm typegen && tsc --noEmit && pnpm --filter studio typecheck",
    "lint": "eslint . && pnpm --filter studio lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm e2e",
    "typegen": "pnpm --filter studio typegen"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-query-devtools": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "groq": "^6.21.0",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sanity": "^6.21.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.70.0"
  }
}
